# ARTEX deployment environment template
# Copy to artex_deployment/.env and fill in real values before `docker compose up -d`
COMPOSE_PROJECT_NAME=artex_cluster
POSTGRES_DB=artex_db
POSTGRES_USER=artex_admin
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_18
DB_HOST=artex-db
DB_PORT=5432
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=CHANGE_ME_YOUR_LLM_KEY
ARTEX_RUN_MODE=human_in_the_loop
